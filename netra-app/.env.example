# NetramNova Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# Google AI Studio API Key (Free)
# Go to https://aistudio.google.com/ to get your free key
GOOGLE_GENERATIVE_AI_API_KEY=

# ML Inference Service Configuration
ML_SERVICE_URL=http://127.0.0.1:5000
PYTHON_BIN=python
ML_REQUEST_TIMEOUT_MS=30000
ML_FALLBACK_TIMEOUT_MS=300000

# Demo Mode (set to true for SIH presentations with mock data)
DEMO_MODE=false
